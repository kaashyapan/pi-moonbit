{
    "name": "pi-moonbit",
    "version": "0.1.1",
    "description": "Pi extension for MoonBit language. Brings moonbit tool chain goodies like peek-def and docs as harness tools.",
    "license": "BSD-3-Clause",
    "author": "kaashyapan",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/kaashyapan/pi-moonbit.git"
    },
    "homepage": "https://github.com/kaashyapan/pi-moonbit",
    "bugs": {
        "url": "https://github.com/kaashyapan/pi-moonbit/issues"
    },
    "type": "module",
    "sideEffects": false,
    "engines": {
        "node": ">=22.19.0"
    },
    "keywords": [
        "pi-package",
        "pi",
        "harness",
        "pi-moonbit",
        "moonbit"
    ],
    "pi": {
        "extensions": [
            "./extensions/index.ts"
        ]
    },
    "files": [
        "LICENSE",
        "README.md",
        "README.mbt.md",
        "extensions"
    ],
    "peerDependencies": {
        "@earendil-works/pi-coding-agent": "^0.85.1",
        "@earendil-works/pi-tui": "^0.85.1"
    },
    "devDependencies": {
        "@earendil-works/pi-coding-agent": "^0.85.1",
        "@earendil-works/pi-tui": "^0.85.1",
        "@tsmbt-bridge/earendil_works__pi_coding_agent": "file:./internal/generated/earendil_works__pi_coding_agent",
        "@tsmbt-bridge/earendil_works__pi_tui": "file:./internal/generated/earendil_works__pi_tui"
    },
    "scripts": {
        "build:moon": "moon build --release",
        "build:js": "bun build _build/js/release/build/src/src.js --outfile ./extensions/moonext.js --minify --target=node --external '@earendil-works/*' --external 'typebox'",
        "build": "bun run build:moon && bun run build:js",
        "test": "bun test",
        "pack:dry": "bun pm pack --dry-run",
        "pack": "bun pm pack",
        "verify": "bun run test && bun run pack:dry",
        "pretest": "bun run build"
    }
}