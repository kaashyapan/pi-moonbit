///|
/// TS interface Args
/// provider : String?
/// model : String?
/// apiKey : String?
/// systemPrompt : String?
/// appendSystemPrompt : Array[String]?
/// thinking : ThinkingLevel?
/// continue : Bool?
/// resume : Bool?
/// help : Bool?
/// version : Bool?
/// mode : Mode?
/// name : String?
/// noSession : Bool?
/// session : String?
/// sessionId : String?
/// fork : String?
/// sessionDir : String?
/// models : Array[String]?
/// tools : Array[String]?
/// excludeTools : Array[String]?
/// noTools : Bool?
/// noBuiltinTools : Bool?
/// extensions : Array[String]?
/// noExtensions : Bool?
/// print : Bool?
/// export : String?
/// noSkills : Bool?
/// skills : Array[String]?
/// promptTemplates : Array[String]?
/// noPromptTemplates : Bool?
/// themes : Array[String]?
/// useTheme : String?
/// noThemes : Bool?
/// noContextFiles : Bool?
/// listModels : Auto_TrueValue_or_StringValue?
/// offline : Bool?
/// tuiMode : TuiMode?
/// verbose : Bool?
/// projectTrustOverride : Bool?
/// messages : Array[String]
/// fileArgs : Array[String]
/// unknownFlags : Map
/// diagnostics : Array[JSValue]
pub(all) struct Args {
  provider : String?
  model : String?
  apiKey : String?
  systemPrompt : String?
  appendSystemPrompt : Array[String]?
  thinking : ThinkingLevel?
  continue_ : Bool?
  resume_ : Bool?
  help : Bool?
  version : Bool?
  mode : Mode?
  name : String?
  noSession : Bool?
  session : String?
  sessionId : String?
  fork : String?
  sessionDir : String?
  models : Array[String]?
  tools : Array[String]?
  excludeTools : Array[String]?
  noTools : Bool?
  noBuiltinTools : Bool?
  extensions : Array[String]?
  noExtensions : Bool?
  print : Bool?
  export_ : String?
  noSkills : Bool?
  skills : Array[String]?
  promptTemplates : Array[String]?
  noPromptTemplates : Bool?
  themes : Array[String]?
  useTheme : String?
  noThemes : Bool?
  noContextFiles : Bool?
  listModels : Auto_TrueValue_or_StringValue?
  offline : Bool?
  tuiMode : TuiMode?
  verbose : Bool?
  projectTrustOverride : Bool?
  messages : Array[String]
  fileArgs : Array[String]
  unknownFlags : Map
  diagnostics : Array[JSValue]
}

